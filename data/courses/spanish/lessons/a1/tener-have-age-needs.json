    "bites": [
      {
        "title": "Spanish HAS feelings",
        "emoji": "🎒",
        "rule": "Where English says 'I am hungry, cold, twenty', Spanish says 'I have hunger, cold, twenty years': tener + noun, never ser or estar.",
        "example": "Tengo hambre y tengo frío.",
        "example_meaning": "I'm hungry and I'm cold."
      },
      {
        "title": "Tengo, then the boot",
        "emoji": "🥾",
        "rule": "The yo form adds a g: tengo. Inside the 'boot' (tú, él, ellos) e becomes ie: tienes, tiene, tienen. Nosotros and vosotros are outside it: tenemos, tenéis.",
        "example": "Tengo dos hermanos. ¿Tienes coche?",
        "example_meaning": "I have two brothers. Do you have a car?"
      },
      {
        "title": "Mucho, not muy",
        "emoji": "💪",
        "rule": "Hambre, frío and sueño are nouns here, so 'very' is mucho or mucha, never muy: tenemos mucho frío, tengo mucha hambre.",
        "example": "Tengo mucha hambre.",
        "example_meaning": "I'm really hungry."
      },
      {
        "title": "Tener que = must",
        "emoji": "✅",
        "rule": "Tener + que + infinitive means 'have to'. Need a thing instead? Use regular necesitar: necesito, necesitas, necesita…",
        "example": "Tengo que trabajar, pero necesito un café.",
        "example_meaning": "I have to work, but I need a coffee."
      }
    ],
