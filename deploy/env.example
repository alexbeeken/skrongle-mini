# /etc/skrongle/env  (chmod 0600, owned by root; read by systemd, not the app user)
#
# Every setting is optional; the unit file sets the ones a box needs. One
# NAME=value per line, then `sudo systemctl restart skrongle`. The full list,
# with defaults, is docs/self-hosting.md "Configuration". To see what the
# service ends up with: sudo /opt/skrongle/skrongle doctor --service
#
# In the order the setup guides (docs/setup-home-wifi.md, setup-tailscale.md)
# meet them:

# The address people open, for the links the server shows (the owner link,
# invitation links). The home Wi-Fi guide sets the first; the Tailscale guide
# replaces it with the second.
#SKRONGLE_PUBLIC_URL=http://skrongle.local:8080
#SKRONGLE_PUBLIC_URL=https://skrongle.<your-tailnet>.ts.net

# 1 once the site is served over HTTPS (Tailscale Serve, a TLS proxy).
#SKRONGLE_SECURE_COOKIES=1

# Where to listen. The unit sets every interface, port 8080. 127.0.0.1:8080
# answers only through Tailscale Serve or a proxy on the same machine.
#SKRONGLE_BIND=127.0.0.1:8080

# Logging: error, warn, info (the default), debug or trace.
#SKRONGLE_LOG=info

# Rarely changed:

# Who may make an account: open (anyone who reaches the server), invite (only
# through an invitation link an owner makes on the Manage Users page; the first
# account on an empty server is made through the owner link in the log) or
# closed (nobody but that first account). The unit sets invite.
#SKRONGLE_SIGNUP=invite

# The youngest age the register page accepts (default 14).
#SKRONGLE_MIN_AGE=14

# Limits on made courses: how many one account may make, and how big.
#SKRONGLE_COURSES_PER_USER=50
#SKRONGLE_COURSE_BYTES=8388608
#SKRONGLE_COURSE_BYTES_PER_USER=33554432

# AI calls: how long one generation job may run, and whether the Ollama row's
# base URL may point at a private address (a server on your own network).
#SKRONGLE_AI_JOB_BUDGET_SECS=3600
#SKRONGLE_ALLOW_PRIVATE_AI_URLS=0

# Sign-in by a reverse proxy (Authelia, Tailscale Serve, ...): the header the
# proxy puts the person's e-mail address in, and the proxy's own addresses
# (IPs or CIDRs, comma-separated). Both or neither. Bind to 127.0.0.1 so
# nobody reaches the app around the proxy. See docs/self-hosting.md.
#SKRONGLE_PROXY_AUTH_HEADER=Remote-Email
#SKRONGLE_PROXY_AUTH_FROM=127.0.0.1
