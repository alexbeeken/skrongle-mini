# /etc/spanish-learning/env  (chmod 0600, owned by root; read by systemd, not the app user)

# The shape (docs/self-hosting.md): SKRONGLE_MINI=1 makes the server a
# Skrongle mini, the self-hosted version (skrongle.service sets it). Unset,
# the server is the hosted site and refuses to start until every provider
# (e-mail, SMS, Stripe) is set. A mini has none of them: no plans
# or payments (every account has every feature, /billing/* answers 404, and
# SKRONGLE_AI_KEY below is shared by every account with no monthly allowance,
# only SKRONGLE_AI_DAILY_CAP and SKRONGLE_AI_RATE_PER_MINUTE), no e-mail, texts
# or S3. Their settings below are ignored in a mini.
#SKRONGLE_MINI=1

# Paid subscriptions through Stripe (see /docs/features#subscriptions). All three
# plus SKRONGLE_PUBLIC_URL, or none; without them nobody can subscribe.
# Webhook endpoint to register in Stripe: <SKRONGLE_PUBLIC_URL>/billing/webhook
#SKRONGLE_STRIPE_SECRET_KEY=sk_live_replace-me
#SKRONGLE_STRIPE_WEBHOOK_SECRET=whsec_replace-me
#SKRONGLE_STRIPE_PRICE_ID=price_replace-me
#SKRONGLE_STRIPE_PRICE_ID_PLUS=price_replace-me-too   # optional: Plus's price; unset, Plus sells at SKRONGLE_STRIPE_PRICE_ID
#SKRONGLE_STRIPE_PRICE_LABEL=$5 a month

# Skrongle AI (see /docs/features#skrongle-ai-allowances-and-credits and
# /docs/pricing): the server's own key, so learners without one can use the
# tutor and the generator within their plan's monthly allowance. Unset: every
# AI feature uses learners' own keys. The defaults below are the ones in the
# code: Plus buys $1.50 of list-price AI a month; Free and Basic get none (docs/pricing.md).
# SKRONGLE_AI_ALLOWANCE_FREE is not monthly: a new account gets it once, as
# credits, when its address is first confirmed.
#SKRONGLE_AI_KEY=sk-ant-replace-me
#SKRONGLE_AI_PROVIDER=anthropic
#SKRONGLE_AI_BASE_URL=
#SKRONGLE_AI_MODEL_TUTOR=claude-haiku-5-5
#SKRONGLE_AI_MODEL_COURSES=claude-sonnet-5-5
# Dollars per million tokens, in/out/cache read; `*` prices unknown models.
#SKRONGLE_AI_PRICES=claude-haiku-5-5=0.10/0.50/0.01,claude-sonnet-5-5=2/10/0.10,claude-opus-5-5=4/20/0.20,*=10/50/1
#SKRONGLE_AI_ALLOWANCE_PLUS=1.50
#SKRONGLE_AI_ALLOWANCE_FREE=0
#SKRONGLE_AI_DAILY_CAP=10.00
#SKRONGLE_AI_RATE_PER_MINUTE=12
# Credit packs (needs Stripe): one-off prices, price_id:credit dollars:label.
# $3.00 of AI for $5 keeps about $1.55 after Stripe's fee.
#SKRONGLE_AI_CREDIT_PACKS=price_replace-me:3.00:$5

# Who may make an account: open (the default: anyone who reaches the
# server), invite (only through an invitation link a superuser makes on the
# Superuser page; the first account made on an empty server is the owner's and a
# superuser, made through the owner link the server writes to its log) or
# closed (nobody but that first account). Skrongle mini default: invite (deploy/skrongle.service sets it).
#SKRONGLE_SIGNUP=open

# Sign-in by a reverse proxy (Authelia, Tailscale Serve, ...): the header the
# proxy puts the person's e-mail address in, and the proxy's own addresses
# (IPs or CIDRs, comma-separated). Both or neither. Bind to 127.0.0.1 so
# nobody reaches the app around the proxy. See docs/self-hosting.md.
#SKRONGLE_PROXY_AUTH_HEADER=Remote-Email
#SKRONGLE_PROXY_AUTH_FROM=127.0.0.1

# The age the registration checkbox states (default 14).
#SKRONGLE_MIN_AGE=14

# E-mail (see /docs/self-hosting#e-mail). Unset SKRONGLE_MAIL_PROVIDERS: messages
# are only logged. scripts/deploy.sh copies every SKRONGLE_MAIL_* line from
# deploy/deploy.env here, so set them there rather than by hand.
#SKRONGLE_MAIL_FROM=Skrongle <noreply@example.org>
#SKRONGLE_MAIL_PROVIDERS=brevo,postmark
#SKRONGLE_MAIL_BREVO_API_KEY=xkeysib-replace-me
#SKRONGLE_MAIL_POSTMARK_API_KEY=replace-me
# E-mails of one kind per hour, each kind its own budget; past it mail waits
# for the next hour (sign-in codes are not queued). 0: no ceiling.
#SKRONGLE_MAIL_PER_HOUR=3000
