# /etc/systemd/system/skrongle.service
#
# Skrongle mini: the unit for self-hosters (docs/self-hosting.md, /self-host),
# and the three SKRONGLE_ lines below are the mini's defaults. The release
# tarball unpacked into /opt/skrongle, the database in /var/lib/skrongle, the
# app on port 8080 of every network interface. Change a setting in
# /etc/skrongle/env, not here. spanish-learning.service is the maintainer's
# own Pi behind nginx.
#
#   sudo mkdir -p /etc/skrongle
#   sudo cp -n /opt/skrongle/terms.example.md /etc/skrongle/terms.md
#   sudo nano /etc/skrongle/terms.md    # your Terms of Service: fill in the [BRACKETS]
#   sudo cp /opt/skrongle/skrongle.service /etc/systemd/system/
#   sudo systemctl enable --now skrongle
#
# Update:      sudo /opt/skrongle/update.sh
# Diagnostics: sudo env $(systemctl show skrongle -p Environment --value) /opt/skrongle/skrongle doctor --env-file /etc/skrongle/env
# Back up /var/lib/skrongle (learn.db and learn.db.key, together).

[Unit]
Description=Skrongle learning app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd creates a locked-down user for the service, so no useradd step.
DynamicUser=yes
WorkingDirectory=/opt/skrongle
ExecStart=/opt/skrongle/skrongle
Restart=on-failure
RestartSec=3

Environment=SKRONGLE_BIND=0.0.0.0:8080
Environment=SKRONGLE_DATA_DIR=/opt/skrongle/data
# The secret key is created next to it as learn.db.key; back up both.
Environment=SKRONGLE_DB=/var/lib/skrongle/learn.db
Environment=SKRONGLE_LOG=info
# This is a Skrongle mini (docs/self-hosting.md, "Skrongle mini"): one small
# box, no plans or payments, no e-mail, SMS, Google or Stripe required.
Environment=SKRONGLE_MINI=1
# Your own Terms at /terms (copy terms.example.md there first; no file, no start):
Environment=SKRONGLE_TERMS=/etc/skrongle/terms.md
# The first account is the owner's, made through the owner link in the log
#   (sudo journalctl -u skrongle -g "Owner link" -o cat | tail -n 1);
# everyone else needs an invitation link from its Superuser page:
Environment=SKRONGLE_SIGNUP=invite
# Optional settings (Google sign-in, a public URL, …): see docs/self-hosting.md.
EnvironmentFile=-/etc/skrongle/env
# glibc malloc: one arena per thread by default; two is plenty and keeps RSS flat.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=65536

# Resource limits, sized for a Pi Zero 2 W
MemoryMax=64M
MemoryHigh=48M
TasksMax=32
# Open files: the listener allows SKRONGLE_MAX_CONNECTIONS (256) connections;
# the rest is SQLite and outgoing calls. Set explicitly, not left to the distro.
LimitNOFILE=1024
CPUWeight=80
Nice=2

# Sandboxing
StateDirectory=skrongle
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
