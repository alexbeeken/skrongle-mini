# /etc/systemd/system/skrongle.service
#
# Skrongle mini: the unit for self-hosters (docs/self-hosting.md, /self-host),
# and the three SKRONGLE_ lines below are the mini's defaults. The release
# tarball unpacked into /opt/skrongle, the database in /var/lib/skrongle, the
# app on port 7576 of every network interface. Change a setting in
# /etc/skrongle/env, not here.
#
#   sudo mkdir -p /etc/skrongle
#   sudo cp /opt/skrongle/skrongle.service /etc/systemd/system/
#   sudo systemctl enable --now skrongle
#
# Update:      sudo /opt/skrongle/update.sh
# Diagnostics: sudo /opt/skrongle/skrongle doctor --service
# Back up /var/lib/skrongle (learn.db and learn.db.key, together).

[Unit]
Description=Skrongle learning app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# systemd creates a locked-down user for the service, so no useradd step.
DynamicUser=yes
WorkingDirectory=/opt/skrongle
ExecStart=/opt/skrongle/skrongle
Restart=on-failure
# 78: the server refused the database (a newer release upgraded it, or it
# predates the 1.0 schema; src/db.rs NEWER_DB_EXIT). Restarting cannot help.
RestartPreventExitStatus=78
RestartSec=3

Environment=SKRONGLE_BIND=0.0.0.0:7576
Environment=SKRONGLE_DATA_DIR=/opt/skrongle/data
# The secret key is created next to it as learn.db.key; back up both.
Environment=SKRONGLE_DB=/var/lib/skrongle/learn.db
Environment=SKRONGLE_LOG=info
# One small box for a handful of accounts (docs/self-hosting.md): no e-mail
# or outside service required.
# The first account is the owner's, made through the owner link in the log
#   (sudo /opt/skrongle/skrongle owner-link --service; the log has it too);
# everyone else needs an invitation link from its Manage Users page:
Environment=SKRONGLE_SIGNUP=invite
# Optional settings (a public URL, …): see docs/self-hosting.md.
EnvironmentFile=-/etc/skrongle/env
# glibc malloc: one arena per thread by default; two is plenty and keeps RSS flat.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=65536

# Resource limits, sized for a Pi Zero 2 W
MemoryMax=64M
MemoryHigh=48M
TasksMax=32
# Open files: 128 connections (caps::MAX_CONNECTIONS, #46) plus SQLite's files,
# outgoing calls (the AI providers) and logs: 128 + ~128 of headroom. Set
# explicitly, not left to the distro.
LimitNOFILE=256
CPUWeight=80
Nice=2

# Sandboxing
StateDirectory=skrongle
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
