#!/usr/bin/env bash
# Start the Skrongle Review Desk and open it in the browser (#1126).
#
#   scripts/review-desk/review               start on a free port, open the page
#   REVIEW_DESK_DRY_RUN=1 scripts/review-desk/review
#                                            print GitHub changes instead of making them
#   scripts/review-desk/review --no-open     start without opening the browser
#
# Settings and logs: ~/skrongle-workflow (REVIEW_DESK_HOME to use another
# folder). Press Ctrl-C to stop it.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
exec python3 -I -B "$here/server.py" "$@"
